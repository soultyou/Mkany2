{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev:api & npm run dev:frontend",
    "dev:api": "API_PORT=3001 npm --workspace=@workspace/api-server run dev",
    "dev:frontend": "npm --workspace=@workspace/mkany-student-housing run dev",
    "build": "npm --workspace=@workspace/api-client-react run build && npm --workspace=@workspace/api-server run build && npm --workspace=@workspace/mkany-student-housing run build",
    "start": "node artifacts/api-server/dist/index.mjs",
    "lint": "npm --workspace=@workspace/mkany-student-housing run typecheck"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@replit/connectors-sdk": "^0.4.1",
    "@supabase/supabase-js": "^2.116.0",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.2.0",
    "leaflet": "^1.9.4",
    "multer": "^2.3.0",
    "postgres": "^3.4.9",
    "serverless-http": "^4.0.0",
    "svix": "^1.21.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "esbuild": "0.27.3"
  },
  "description": "",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "keywords": [],
  "author": ""
}
