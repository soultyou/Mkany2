# ==========================================================
# MKANY Student Housing - Production Environment Variables
# ==========================================================

# ----------------------------------------------------------
# 1. PUBLIC FRONTEND VARIABLES (Configured in Cloudflare / Vite)
# ----------------------------------------------------------
# Public Clerk publishable key (Starts with pk_test_ or pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Optional: Set custom API base URL if frontend and API are hosted on different domains.
# If both frontend and worker are deployed together on Cloudflare, leave empty or set to /
VITE_API_URL=

# ----------------------------------------------------------
# 2. SERVER-ONLY SECRETS (Configured in Cloudflare Worker Secrets / Wrangler)
# ----------------------------------------------------------
# Clerk backend secret key (Starts with sk_test_ or sk_live_)
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Starts with whsec_)
CLERK_WEBHOOK_SECRET=

# PostgreSQL Database Connection String (Direct or Hyperdrive pooled URL)
DATABASE_URL=

# Optional Supabase integration (for storage / edge services)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Allowed CORS origins (Comma-separated list of extra allowed frontend domains)
ALLOWED_ORIGINS=
